{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estia-crm",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // The app files are served only after the login check in worker/index.js.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "estia-crm", "database_id": "c82f6258-a625-4884-85fb-7f5832c8dd44" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "estia-crm-media" }
  ],
  // The CRM's address. estiagreekhome.online must be a zone in this Cloudflare account.
  "routes": [
    { "pattern": "crm.estiagreekhome.online", "custom_domain": true }
  ],
  // GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are set as secrets in the dashboard; keep them on deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
}
