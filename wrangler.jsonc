{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estia-crm",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // The app files are served only after the login check in worker/index.js.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "estia-crm", "database_id": "c82f6258-a625-4884-85fb-7f5832c8dd44" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "estia-crm-media" }
  ],
  "observability": { "enabled": true }
}
